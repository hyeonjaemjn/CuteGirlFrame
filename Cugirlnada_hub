-- Device spoof (Lunara: SetControls remote)
local DEVICE_CFGS = {
	Mobile = { Code = "Touch" },
	Console = { Code = "Gamepad" },
	VR = { Code = "VR" },
	PC = { Code = "MouseKeyboard" },
	Computer = { Code = "MouseKeyboard" },
