--[[ Cute girl hub - HitNotify only patch loader. UI = original remote, untouched. ]]
local URL = "https://raw.githubusercontent.com/cutegirl131313/Cutegirl_hub/refs/heads/main/Cute_girl_hub"

local src
local ok, err = pcall(function()
	src = game:HttpGet(URL)
end)
if not ok or type(src) ~= "string" or #src < 1000 then
	warn("[hub] HttpGet fail:", err or src)
	return
end

local markA = "-- Hit Notify (Lunara-style floating damage numbers on target)"
local markB = "\n-- Hit Sound (replace gun/viewmodel sounds)"
local a = string.find(src, markA, 1, true)
local b = string.find(src, markB, 1, true)
if not a or not b or b <= a then
	warn("[hub] HitNotify markers not found - running original as-is")
	loadstring(src)()
	return
end

local NEW = [=[
-- Hit Notify (Top-Edge Custom UI Box)
pcall(function()
	local CoreGui = game:GetService("CoreGui")
	if CoreGui:FindFirstChild("CustomHitNotifyGui") then
		CoreGui.CustomHitNotifyGui:Destroy()
	end
end)

