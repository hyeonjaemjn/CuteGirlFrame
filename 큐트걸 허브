end)
if not ScreenGui.Parent then
	pcall(function()
		ScreenGui.Parent = LP:FindFirstChild("PlayerGui") or LP:WaitForChild("PlayerGui", 3)
	end)
end

local Container = Instance.new("Frame")
Container.Size = UDim2.new(0, 300, 0, 400)
Container.Position = UDim2.new(1, -320, 0, 0)
Container.BackgroundTransparency = 1
Container.Parent = ScreenGui

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Top
UIListLayout.Padding = UDim.new(0, 5)
UIListLayout.Parent = Container

local function showHitUI(text)
	task.spawn(function()
		local Box = Instance.new("Frame")
		Box.Size = UDim2.new(1, 0, 0, 30)
		Box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		Box.BackgroundTransparency = 0.2
		Box.BorderSizePixel = 0
		Box.Parent = Container

		local UICorner = Instance.new("UICorner")
		UICorner.CornerRadius = UDim.new(0, 4)
		UICorner.Parent = Box

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, -10, 1, 0)
		Label.Position = UDim2.new(0, 10, 0, 0)
		Label.BackgroundTransparency = 1
		Label.Font = Enum.Font.SourceSansBold
		Label.TextSize = 14
		Label.TextColor3 = Color3.fromRGB(255, 255, 255)
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Text = text
		Label.Parent = Box

		task.wait(1.5)
		for i = 0.2, 1, 0.1 do
			Box.BackgroundTransparency = i
			Label.TextTransparency = i
			task.wait(0.02)
		end
		Box:Destroy()
	end)
end

local lastHP = {}
RunService.Heartbeat:Connect(function()
	if not S.HitNotify then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				local id = plr.UserId
				local hp = hum.Health
				local prev = lastHP[id]
				if prev and hp < prev - 0.1 then
					local dmg = math.floor(prev - hp + 0.5)
					if dmg > 0 then
						showHitUI(string.format("Hit %s Damage %d", plr.Name, dmg))
					end
				end
				lastHP[id] = hp
			end
		end
	end
end)

]=]

src = string.sub(src, 1, a - 1) .. NEW .. string.sub(src, b)
print("[hub] HitNotify patched, loading...")
loadstring(src)()
